<%- include('partials/head') %>
<%
  var open = run.status === 'Open';
  var c = costing;
%>
<h1><%= run.code %> <span class="pill <%= open ? 'Pending' : 'Paid' %>"><%= run.status %></span></h1>
<p class="sub">
  <%= run.area || 'no area recorded' %> · started <%= run.started_on %>
  <% if (run.ended_on) { %>· closed <%= run.ended_on %><% } %>
  <% if (run.officer_name) { %>· <%= run.officer_name %><% } %>
  <% if (run.vehicle_reg) { %>· <%= run.vehicle_reg %><% } %>
</p>

<% if (flash) { %><div class="flash err"><%= flash %></div><% } %>
<% if (ok) { %><div class="flash ok"><%= ok %></div><% } %>

<!-- ---------------------------------------------------- the answer -->
<div class="tiles">
  <div class="tile">
    <div class="label">Collected</div>
    <div class="value"><%= weight(c.payableG, unit).value %> <%= weight(c.payableG, unit).suffix %></div>
    <div class="target"><%= c.loads %> load(s)</div>
  </div>
  <div class="tile">
    <div class="label">Grain / tonne</div>
    <div class="value"><%= money(c.grainPerTonneCents) %></div>
    <div class="target">paid to suppliers</div>
  </div>
  <div class="tile">
    <div class="label">Trip cost / tonne</div>
    <div class="value"><%= money(c.overheadPerTonneCents) %></div>
    <div class="target"><%= fromBp(c.overheadBp) %>% on top of the grain</div>
  </div>
  <div class="tile">
    <div class="label">True landed / tonne</div>
    <div class="value"><%= money(c.landedPerTonneCents) %></div>
    <div class="target">what it really cost</div>
  </div>
  <% if (comparison) { %>
    <div class="tile">
      <div class="label">vs contracted grain</div>
      <div class="value <%= comparison.differenceCents >= 0 ? 'badge-pos' : 'badge-neg' %>">
        <%= comparison.differenceCents >= 0 ? '+' : '−' %><%= money(Math.abs(comparison.differenceCents)) %>
      </div>
      <div class="target">
        <%= comparison.differenceCents >= 0 ? 'cheaper' : 'dearer' %> than buying
        <%= weight(c.payableG, unit).value %> <%= weight(c.payableG, unit).suffix %> at
        KES <%= money(contractedPerTonneCents) %>/tonne
      </div>
    </div>
  <% } %>
</div>

<% if (c.loads > 0 && comparison) { %>
  <div class="card" style="margin-top:1rem">
    <p style="margin:0" class="small">
      <% if (comparison.differenceCents >= 0) { %>
        <strong>This run was worth doing.</strong> Even after transport, labour, food
        and allowances, the grain landed at KES <%= money(c.landedPerTonneCents) %> a tonne —
        <%= money(Math.abs(comparison.differencePerTonneCents)) %> less per tonne than
        contracted grain actually cost us this season.
      <% } else { %>
        <strong>This run cost more than contracted grain.</strong> It landed at
        KES <%= money(c.landedPerTonneCents) %> a tonne against contracted grain at
        KES <%= money(comparison.budgetPerTonneCents) %> a tonne — the trip costs, not the
        price paid at the gate, are usually what does this.
      <% } %>
    </p>
  </div>
<% } %>

<% if (open) { %>
  <details class="card" <%= (!run.area || !run.vehicle_reg) ? 'open' : '' %>>
    <summary style="cursor:pointer;font-weight:600;font-size:0.9rem">
      Edit run details
      <span class="muted small">— area, vehicle, date and notes, while this run is open</span>
    </summary>
    <form method="post" action="/outsourcing/runs/<%= run.id %>/update" class="grid" style="margin-top:0.8rem">
      <div><label for="e_area">Area</label>
        <input id="e_area" name="area" value="<%= run.area %>" required></div>
      <div><label for="e_veh">Vehicle</label>
        <input id="e_veh" name="vehicle_reg" value="<%= run.vehicle_reg %>"></div>
      <div><label for="e_date">Date</label>
        <input id="e_date" name="started_on" type="date" value="<%= run.started_on %>"></div>
      <div style="grid-column:1/-1"><label for="e_notes">Notes</label>
        <input id="e_notes" name="notes" value="<%= run.notes %>"></div>
      <div class="actions"><button type="submit">Save details</button></div>
    </form>
  </details>
<% } %>

<%- include("partials/run-planning") %>

<div class="split">
  <!-- ---------------------------------------------- what the trip cost -->
  <div class="card">
    <h3>What the trip cost</h3>
    <%- include('partials/working', { lines: c.lines }) %>

    <% if (open) { %>
      <form method="post" action="/outsourcing/runs/<%= run.id %>/costs" class="grid" style="margin-top:0.8rem">
        <div><label for="kind">Cost</label>
          <select id="kind" name="kind" required>
            <% Object.keys(costKinds).forEach(function (k) { %>
              <option value="<%= k %>"><%= costKinds[k] %></option>
            <% }); %>
          </select></div>
        <div><label for="amount">Amount (KES)</label>
          <input id="amount" name="amount" class="num" required placeholder="8000.00"></div>
        <div><label for="description">Description</label><input id="description" name="description"></div>
        <div><label style="text-transform:none;letter-spacing:0">
            <input type="checkbox" name="is_projected" style="width:auto"> Projected (budget)
          </label></div>
        <div class="actions"><button type="submit">Add cost</button></div>
      </form>
    <% } %>

    <% if (costs.length) { %>
      <table style="margin-top:0.7rem">
        <thead><tr><th>Kind</th><th>Description</th><th>Date</th><th class="num">Amount</th></tr></thead>
        <tbody>
        <% costs.forEach(function (x) { %>
          <tr>
            <% if (open) { %>
              <td colspan="4" style="padding:0.3rem 0.6rem">
                <form method="post" action="/outsourcing/costs/<%= x.id %>/update"
                      class="grid" style="grid-template-columns:1.3fr 1.6fr 0.9fr auto auto;gap:0.4rem">
                  <input type="hidden" name="run_id" value="<%= run.id %>">
                  <select name="kind" aria-label="Cost kind">
                    <% Object.keys(costKinds).forEach(function (k) { %>
                      <option value="<%= k %>" <%= x.kind === k ? 'selected' : '' %>><%= costKinds[k] %></option>
                    <% }); %>
                  </select>
                  <input name="description" value="<%= x.description %>" placeholder="description" aria-label="Description">
                  <input name="amount" class="num" value="<%= fromCents(x.amount_cents) %>" aria-label="Amount">
                  <button type="submit" class="ghost" title="Save this line">Save</button>
                  <button type="submit" class="ghost" title="Remove this line"
                          formaction="/outsourcing/costs/<%= x.id %>/delete">✕</button>
                </form>
              </td>
            <% } else { %>
              <td class="small"><%= costKinds[x.kind] || x.kind %></td>
              <td class="small muted"><%= x.description %></td>
              <td class="small"><%= x.incurred_on %></td>
              <td class="num"><%= money(x.amount_cents) %></td>
            <% } %>
          </tr>
        <% }); %>
        </tbody>
        <tfoot><tr class="total"><td colspan="3">TOTAL</td>
          <td class="num"><%= money(c.overheadCents) %></td></tr></tfoot>
      </table>
    <% } %>
  </div>

  <!-- ---------------------------------------------------- buy a load -->
  <div class="card" id="quote">
    <h3>Buy a load</h3>
    <% if (!open) { %>
      <p class="empty">This run is closed. Nothing more can be bought onto it.</p>
    <% } else if (suppliers.length === 0) { %>
      <p class="empty">No suppliers on file. <a href="/outsourcing/suppliers">Add one</a> first.</p>
    <% } else { %>

      <% if (quote) { %>
        <div class="quote">
          <% if (quote.rejected) { %>
            <strong>This load grades REJECT.</strong>
            Too wet or too dirty to buy. Recording it still costs nothing and
            keeps the trip honest.
          <% } else { %>
            <div class="working">
              <% quote.priced.lines.forEach(function (l) { %>
                <div class="row <%= l.total ? 'total' : '' %> <%= l.note ? 'note' : '' %>">
                  <span class="lbl"><%= l.label %></span>
                  <span class="val <%= l.value < 0 ? 'neg' : '' %>">
                    <% if (l.kind === 'weight') { %><%= kg(Math.abs(l.value)) %> kg
                    <% } else { %><%= l.value < 0 ? '−' : '' %>KES <%= money(Math.abs(l.value)) %><% } %>
                  </span>
                </div>
              <% }); %>
            </div>
            <p class="small" style="margin:0.6rem 0 0">
              Grade <strong><%= quote.grade %></strong>.
              <% if (quote.priced.priceBasis === 'negotiated') { %>
                You are agreeing KES <%= money(quote.priced.agreedPriceCents) %>/kg against a
                graded value of KES <%= money(quote.priced.referencePriceCents) %>/kg —
                a difference of
                <strong class="<%= quote.priced.varianceCents >= 0 ? 'badge-neg' : 'badge-pos' %>">
                  <%= quote.priced.varianceCents >= 0 ? '+' : '−' %>KES <%= money(Math.abs(quote.priced.varianceValueCents)) %>
                </strong>
                on this load. You must say why below.
              <% } else { %>
                Priced straight off the spot schedule.
              <% } %>
            </p>
          <% } %>
        </div>
      <% } %>

      <form method="post" action="/outsourcing/runs/<%= run.id %>/buy" class="grid">
        <div style="grid-column:span 2"><label for="supplier_id">Supplier</label>
          <select id="supplier_id" name="supplier_id" required>
            <% suppliers.forEach(function (s) { %>
              <option value="<%= s.id %>" <%= q.supplier_id === String(s.id) ? 'selected' : '' %>>
                <%= s.code %> — <%= s.name %><%= s.area ? ' (' + s.area + ')' : '' %>
              </option>
            <% }); %>
          </select></div>
        <div><label for="gross_kg">Gross (kg)</label>
          <input id="gross_kg" name="gross_kg" class="num" required value="<%= q.gross_kg %>" placeholder="480.000"></div>
        <div><label for="tare_kg">Tare (kg)</label>
          <input id="tare_kg" name="tare_kg" class="num" required value="<%= q.tare_kg %>" placeholder="12.000"></div>
        <div><label for="moisture">Moisture %</label>
          <input id="moisture" name="moisture" class="num" required value="<%= q.moisture %>" placeholder="10.50"></div>
        <div><label for="oil">Oil %</label>
          <input id="oil" name="oil" class="num" required value="<%= q.oil %>" placeholder="41.00"></div>
        <div><label for="foreign">Foreign %</label>
          <input id="foreign" name="foreign" class="num" required value="<%= q.foreign %>" placeholder="3.00"></div>
        <div><label for="damage">Damage %</label>
          <input id="damage" name="damage" class="num" required value="<%= q.damage %>" placeholder="4.00"></div>
        <div><label for="agreed">Agreed price (KES/kg)</label>
          <input id="agreed" name="agreed" class="num" value="<%= q.agreed %>" placeholder="leave blank for schedule"></div>
        <div style="grid-column:span 2"><label for="price_reason">Why the agreed price differs</label>
          <input id="price_reason" name="price_reason" placeholder="required only if you override the schedule"></div>
        <div><label for="reference">Payment reference</label><input id="reference" name="reference" placeholder="M-Pesa code"></div>
        <div style="grid-column:1/-1"><label for="notes">Notes</label><input id="notes" name="notes"></div>
        <div class="actions">
          <button type="submit" formaction="/outsourcing/runs/<%= run.id %>/quote" class="ghost">Price it first</button>
          <button type="submit">Buy this load</button>
        </div>
      </form>
      <p class="small muted" style="margin-bottom:0">
        Grading uses exactly the same rules as contracted grain. A negotiated
        price is allowed, but it must record a reason — the database refuses it
        otherwise.
      </p>
    <% } %>
  </div>
</div>

<!-- ---------------------------------------------------------- loads -->
<h2>Loads on this run</h2>
<div class="card scroll">
  <table>
    <thead><tr><th>Code</th><th>Supplier</th><th>Grade</th>
      <th class="num">Net</th><th class="num">Payable</th>
      <th class="num">Graded at</th><th class="num">Agreed</th><th class="num">Variance</th>
      <th class="num">Paid</th><th class="num">Trip share</th><th class="num">Landed / t</th>
      <th>Status</th><th>Why</th><th></th></tr></thead>
    <tbody>
    <% if (purchases.length === 0) { %>
      <tr><td colspan="14" class="empty">Nothing bought on this run yet.</td></tr>
    <% } %>
    <% purchases.forEach(function (p, i) {
         var per = c.perLoad.find(function (x) { return x.id === p.id; }); %>
      <tr <%= p.voided_at ? 'style="opacity:0.45;text-decoration:line-through"' : '' %>>
        <td class="code"><%= p.code %></td>
        <td><%= p.supplier_name %></td>
        <td><span class="pill <%= p.grade %>"><%= p.grade %></span></td>
        <td class="num"><%= weight(p.net_g, unit).value %></td>
        <td class="num"><%= weight(p.payable_g, unit).value %></td>
        <td class="num"><%= p.status === 'Rejected' ? '—' : money(p.reference_price_cents) %></td>
        <td class="num"><%= p.status === 'Rejected' ? '—' : money(p.agreed_price_cents) %></td>
        <td class="num <%= p.agreed_price_cents > p.reference_price_cents ? 'badge-neg' : p.agreed_price_cents < p.reference_price_cents ? 'badge-pos' : '' %>">
          <% if (p.status === 'Rejected') { %>—
          <% } else if (p.agreed_price_cents === p.reference_price_cents) { %>—
          <% } else { %><%= p.agreed_price_cents > p.reference_price_cents ? '+' : '−' %><%= money(Math.abs(p.agreed_price_cents - p.reference_price_cents)) %><% } %>
        </td>
        <td class="num"><%= money(p.net_payable_cents) %></td>
        <td class="num"><%= per ? money(per.allocatedCostCents) : '—' %></td>
        <td class="num"><%= per && per.landedPerTonneCents ? money(per.landedPerTonneCents) : '—' %></td>
        <td><span class="pill <%= p.status %>"><%= p.status %></span></td>
        <td class="notes"><%= p.price_reason %></td>
        <td>
          <% if (p.voided_at) { %>
            <span class="pill bad">Voided</span>
          <% } else { %>
            <% if (p.status === 'Unpaid') { %>
              <form method="post" action="/outsourcing/purchases/<%= p.id %>/pay" style="margin-bottom:0.3rem">
                <input type="hidden" name="back" value="/outsourcing/runs/<%= run.id %>">
                <input type="hidden" name="reference" value="<%= p.reference %>">
                <button type="submit">Mark paid</button>
              </form>
            <% } %>
            <% if (open && p.status !== 'Paid') { %>
              <details>
                <summary class="small muted" style="cursor:pointer">Void</summary>
                <form method="post" action="/outsourcing/purchases/<%= p.id %>/void" style="margin-top:0.3rem">
                  <input type="hidden" name="run_id" value="<%= run.id %>">
                  <input name="reason" required placeholder="why?" style="min-width:9rem">
                  <button type="submit" class="ghost">Confirm</button>
                </form>
              </details>
            <% } %>
          <% } %>
        </td>
      </tr>
    <% }); %>
    </tbody>
    <% if (purchases.length) { %>
      <tfoot><tr class="total">
        <td colspan="4">TOTAL</td>
        <td class="num"><%= weight(c.payableG, unit).value %></td>
        <td colspan="3"></td>
        <td class="num"><%= money(c.purchaseCents) %></td>
        <td class="num"><%= money(c.overheadCents) %></td>
        <td colspan="4"></td>
      </tr></tfoot>
    <% } %>
  </table>
  <p class="small muted" style="margin:0.6rem 0 0">
    "Trip share" spreads the run's costs across the loads by weight. The shares
    always add back to exactly the trip total — no cent is lost or invented.
  </p>
</div>

<div class="card">
  <div class="actions">
    <% if (open) { %>
      <form method="post" action="/outsourcing/runs/<%= run.id %>/close">
        <button type="submit">Close this run</button>
      </form>
      <span class="small muted">Closing stops any more loads being added.</span>
    <% } else if (user.role === 'owner' || user.role === 'ops_manager') { %>
      <form method="post" action="/outsourcing/runs/<%= run.id %>/reopen">
        <button class="ghost" type="submit">Reopen</button>
      </form>
    <% } %>
    <a class="btn ghost" href="/outsourcing">← All runs</a>
  </div>
</div>
<%- include('partials/foot') %>
