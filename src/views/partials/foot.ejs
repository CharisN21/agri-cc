<%# head.ejs opens three elements when signed in (.shell > .content > main) and
    two when signed out (.plain > main). Close the matching number. %>
      </main>
<% if (typeof user !== 'undefined' && user) { %>
    </div>
  </div>
<% } else { %>
  </div>
<% } %>
<script>
  var themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) themeBtn.addEventListener('click', function () {
    var root = document.documentElement;
    var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  // The sidebar is fixed on a wide screen and slides in on a narrow one — a
  // field officer is usually on a phone.
  var navBtn = document.getElementById('nav-toggle');
  if (navBtn) navBtn.addEventListener('click', function () {
    document.getElementById('sidebar').classList.toggle('open');
  });

  // Switching units must not lose the season, and vice versa.
  document.querySelectorAll('.unit-pick a').forEach(function (a) {
    var here = new URL(window.location.href);
    var want = new URL(a.getAttribute('href'), window.location.href);
    here.searchParams.set('unit', want.searchParams.get('unit'));
    a.setAttribute('href', here.pathname + here.search);
  });
  var seasonForm = document.getElementById('season-form');
  if (seasonForm) {
    new URL(window.location.href).searchParams.forEach(function (v, k) {
      if (k === 'season') return;
      var hidden = document.createElement('input');
      hidden.type = 'hidden'; hidden.name = k; hidden.value = v;
      seasonForm.appendChild(hidden);
    });
  }
</script>
</body>
</html>
